# Named environment from config/settings.py: local | dev | qa | prod
TEST_ENV=local

# Language: a short code from config/settings.py (fr, de, es, ja, ...) or a
# BCP-47 tag like fr-FR. Drives the browser locale and the API client's
# Accept-Language header.
TEST_LANGUAGE=en

# Optional per-field overrides. When set, these win over the selected
# environment's defaults (useful for an ephemeral deployment URL in CI).
# PYTEST_BASE_URL=https://qa.example.com
# COUNTRY_API_BASE_URL=https://api.qa.example.com
# API_TIMEOUT_SECONDS=10
